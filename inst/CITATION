citHeader("To cite openalexVectorComp in publications use:")

# Version and year come from the installed package, so nothing to bump at release.
year <- substr(c(meta$`Date/Publication`, meta$Date, meta$Packaged, format(Sys.Date()))[1], 1, 4)

bibentry(
  bibtype = "Manual",
  key     = "openalexVectorComp",
  title   = "{openalexVectorComp}: Embedding Vectorization and Distance-Based Scoring Workflows",
  author  = person("Rainer M", "Krug", comment = c(ORCID = "0000-0002-7490-0066")),
  year    = year,
  note    = paste("R package version", meta$Version),
  doi     = "10.5281/zenodo.19607514",
  url     = "https://github.com/openalexPro/openalexVectorComp",
  textVersion = paste0(
    "Krug, R. M. (", year, "). openalexVectorComp: Embedding Vectorization and Distance-Based Scoring Workflows. ",
    "R package version ", meta$Version, ". https://doi.org/10.5281/zenodo.19607514"
  )
)

bibentry(
  header  = "openalexVectorComp is part of the openalexPro ecosystem; to cite the ecosystem as a whole use:",
  bibtype = "Misc",
  key     = "openalexProEcosystem",
  title   = "The {openalexPro} ecosystem: R packages for large-scale work with OpenAlex",
  author  = person("Rainer M", "Krug", comment = c(ORCID = "0000-0002-7490-0066")),
  year    = year,
  url     = "https://openalexpro.github.io/",
  textVersion = paste0(
    "Krug, R. M. (", year, "). The openalexPro ecosystem: R packages for ",
    "large-scale work with OpenAlex. https://openalexpro.github.io/"
  )
